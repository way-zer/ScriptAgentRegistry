ID ktor
FQ_NAME ktor.Module
+DEPENDS coreLibrary 
+DEPENDS kcp/serialization 
+IMPORT DefaultImport io.ktor.http.*
+IMPORT DefaultImport io.ktor.server.application.*
+IMPORT DefaultImport io.ktor.server.request.*
+IMPORT DefaultImport io.ktor.server.response.*
+IMPORT DefaultImport io.ktor.server.routing.*
+IMPORT DefaultImport ktor.lib.*
+IMPORT MavenDepends io.ktor:ktor-client-cio-jvm:3.3.3
+IMPORT MavenDepends io.ktor:ktor-client-content-negotiation-jvm:3.3.3
+IMPORT MavenDepends io.ktor:ktor-serialization-kotlinx-json-jvm:3.3.3
+IMPORT MavenDepends io.ktor:ktor-server-content-negotiation-jvm:3.3.3
+IMPORT MavenDepends io.ktor:ktor-server-netty-jvm:3.3.3

ID ktor/simple
FQ_NAME ktor.Simple
+DEPENDS ktor module
+IMPORT MavenDepends io.ktor:ktor-server-call-logging-jvm:3.3.3

